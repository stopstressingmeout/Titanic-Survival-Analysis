      "source": [
        "# Encoding Categorical Variables\n",
        "\n",
        "df_enc = df.copy()\n",
        "\n",
        "cat_features = [\"Sex\", \"Embarked\", \"Pclass\"]\n",
        "numeric_features = [\"Age\", \"Fare\", \"SibSp\", \"Parch\"]\n",
        "target_col = \"Survived\"\n",
        "\n",
        "# One hot encoding categorical variables\n",
        "ohe = OneHotEncoder(sparse_output=False, drop=None)\n",
        "encoded_array = ohe.fit_transform(df_enc[cat_features])\n",
        "encoded_df = pd.DataFrame(encoded_array, columns=ohe.get_feature_names_out(cat_features))\n",
        "\n",
        "# Building final encoded DataFrame\n",
        "df_model = pd.concat([\n",
        "    df_enc[[target_col] + numeric_features],\n",
        "    encoded_df\n",
        "], axis=1)\n",
        "\n",
        "print(\"Shape after encoding:\", df_model.shape)\n",
        "display(df_model.head())"
      ]
    },
